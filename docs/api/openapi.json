{
  "openapi": "3.1.0",
  "info": {
    "title": "Watheeq API",
    "version": "1.0.0",
    "description": "The Watheeq legal affairs API.\n\nSuccess, list, and error shapes, authentication, and access are described once in the API guide, not per operation:\n\n- [Conventions](docs/api/conventions.md): response and list shapes, cursors, filters, and the Read-only state.\n- [Errors](docs/api/errors.md): every error code and detail code.\n- [Authentication](docs/api/auth.md): the access and refresh cookies.\n- [Access](docs/api/access.md): who can call what."
  },
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "auth"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in; sets the access and refresh cookies",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_CREDENTIALS`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "`PAYLOAD_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "`UNSUPPORTED_MEDIA_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke the refresh token and clear both cookies",
        "responses": {
          "204": {
            "description": "No content"
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user and their subscription status",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Change the password and sign out the other sessions",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`, `INVALID_CREDENTIALS`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "`PAYLOAD_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "`UNSUPPORTED_MEDIA_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Use a reset link to set a new password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "`VALIDATION_FAILED`, `VERIFICATION_INVALID`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "`PAYLOAD_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "`UNSUPPORTED_MEDIA_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password-reset/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email a password reset link; always 204",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "`PAYLOAD_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "`UNSUPPORTED_MEDIA_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate the refresh cookie and issue a new session",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Use an invitation or verification link to set a password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "`VALIDATION_FAILED`, `VERIFICATION_INVALID`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "`PAYLOAD_TOO_LARGE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "`UNSUPPORTED_MEDIA_TYPE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Whether the server can reach its database",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Health"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "`SERVICE_UNAVAILABLE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wq_access"
      }
    },
    "schemas": {
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "operator"
            ]
          },
          "tenant": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "roleId": {
                    "type": "string"
                  },
                  "roleName": {
                    "type": "string"
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "roleId",
                  "roleName",
                  "permissions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "userName",
          "role",
          "tenant"
        ],
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "VERIFICATION_INVALID",
                  "UNAUTHENTICATED",
                  "INVALID_CREDENTIALS",
                  "FORBIDDEN",
                  "SELF_CHANGE_FORBIDDEN",
                  "PERMISSION_NOT_HELD",
                  "SUBSCRIPTION_READ_ONLY",
                  "SUBSCRIPTION_NOT_ACTIVE",
                  "NOT_FOUND",
                  "TAKEN",
                  "VERSION_CHANGED",
                  "ALREADY_VERIFIED",
                  "USER_LIMIT_REACHED",
                  "UNIT_NOT_EMPTY",
                  "OWNER_PROTECTED",
                  "USER_INACTIVE",
                  "ROLE_IN_USE",
                  "ROLE_PROTECTED",
                  "CALENDAR_DATE_LOCKED",
                  "CALENDAR_PERIOD_ENDED",
                  "POSITION_IN_USE",
                  "POSITION_UNIT_GONE",
                  "RESOURCE_RETIRED",
                  "WORKFLOW_POSITION_RETIRED",
                  "WORKFLOW_IN_USE",
                  "SERVICE_WORKFLOW_RETIRED",
                  "ESCALATION_NOT_CONFIGURED",
                  "INVALID_REQUEST_STATE",
                  "STAGE_NOT_ACTIVE",
                  "NO_EARLIER_STAGE",
                  "NO_HIGHER_LEVEL",
                  "INFORMATION_REQUEST_OPEN",
                  "NO_OPEN_INFORMATION_REQUEST",
                  "TOO_MANY_FILES",
                  "UPLOAD_QUOTA_REACHED",
                  "STORAGE_LIMIT_REACHED",
                  "LENGTH_REQUIRED",
                  "PAYLOAD_TOO_LARGE",
                  "FILE_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "FILE_TYPE_NOT_ALLOWED",
                  "INTERNAL",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "required": [
              "code",
              "requestId",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_type",
              "too_small",
              "too_big",
              "invalid_format",
              "invalid_value",
              "not_multiple_of",
              "invalid_union",
              "invalid_key",
              "invalid_element",
              "unknown_field",
              "no_fields",
              "invalid_json",
              "invalid_cursor",
              "taken",
              "permission_not_held",
              "above_maximum",
              "below_minimum",
              "department_has_no_parent",
              "duplicate_field_id",
              "duplicate_label",
              "duplicate_name",
              "duplicate_option",
              "duplicate_permission",
              "duplicate_recipient",
              "duplicate_user",
              "duplicate_workflow",
              "empty_file",
              "end_before_start",
              "file_attached",
              "file_expired",
              "handler_is_requester",
              "handler_not_eligible",
              "holds_other_position",
              "in_future",
              "invalid_date",
              "invalid_day",
              "invalid_name",
              "length_mismatch",
              "manager_needs_unit",
              "many_defaults",
              "min_above_max",
              "no_default",
              "no_occurrence",
              "no_recipients",
              "no_working_day",
              "not_allowed",
              "not_assignee",
              "not_for_rule",
              "not_integer",
              "not_recurring",
              "not_unit_member",
              "order_mismatch",
              "parent_not_department",
              "period_too_long",
              "position_retired",
              "priority_retired",
              "range_too_long",
              "rank_taken",
              "required",
              "same_handler",
              "scope_not_allowed",
              "service_retired",
              "too_far_ahead",
              "too_long",
              "too_many_decimals",
              "too_many_files",
              "too_many_stages",
              "type_changed",
              "unknown_field_id",
              "unknown_file",
              "unknown_notification",
              "unknown_option",
              "unknown_option_id",
              "unknown_permission",
              "unknown_plan",
              "unknown_position",
              "unknown_priority",
              "unknown_role",
              "unknown_service",
              "unknown_unit",
              "unknown_workflow",
              "user_inactive",
              "version_changed",
              "workflow_not_allowed",
              "workflow_retired",
              "wrong_type"
            ]
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "db": {
            "type": "string",
            "const": "up"
          }
        },
        "required": [
          "status",
          "db"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "nextCursor",
          "total"
        ],
        "additionalProperties": false
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256
          }
        },
        "required": [
          "token",
          "password"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "subscription": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user",
          "subscription"
        ],
        "additionalProperties": false
      },
      "SubscriptionStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "grace",
              "read_only"
            ]
          },
          "endDate": {
            "type": "string"
          },
          "graceEndsOn": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "endDate",
          "graceEndsOn"
        ],
        "additionalProperties": false
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256
          }
        },
        "required": [
          "token",
          "password"
        ],
        "additionalProperties": false
      }
    }
  }
}
