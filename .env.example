# Copy to .env for local development (never commit .env).
# Loaded by `pnpm dev`, `pnpm db:migrate`, and `pnpm operator:create`. `pnpm start` reads the real process environment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml. Used by the app, migrations, and the operator CLI.
DATABASE_URL=postgres://watheeq:watheeq@localhost:5432/watheeq

# Access-token signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=local-development-only-jwt-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# Verification emails. Locally these go to Mailpit from docker-compose.yml: open http://localhost:8025 to read them.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Watheeq <no-reply@watheeq.local>
# The web app's origin; verification links point to ${APP_BASE_URL}/verify-email?token=...
APP_BASE_URL=http://localhost:5173
VERIFICATION_TOKEN_TTL_SECONDS=259200
