# Copy to .env for local development (never commit .env).
# Loaded by `pnpm dev` and `pnpm db:migrate` only. `pnpm start` reads the real process environment.
# Matches docker-compose.yml.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Runtime connection: the application connects as watheeq_app (no BYPASSRLS, owns nothing).
DATABASE_URL=postgres://watheeq_app:watheeq_app@localhost:5432/watheeq

# Operator session lifetimes in seconds (defaults shown: 30 minutes idle, 8 hours absolute).
OPERATOR_SESSION_IDLE_SECONDS=1800
OPERATOR_SESSION_ABSOLUTE_SECONDS=28800

# Tenant session lifetimes in seconds (defaults shown: 2 hours idle, 12 hours absolute).
TENANT_SESSION_IDLE_SECONDS=7200
TENANT_SESSION_ABSOLUTE_SECONDS=43200

# Login throttling, both realms (defaults shown).
# An account locks for LOGIN_ACCOUNT_LOCK_SECONDS after LOGIN_ACCOUNT_MAX_FAILURES consecutive wrong passwords.
# A client IP is blocked after LOGIN_IP_MAX_FAILURES failed logins within LOGIN_IP_WINDOW_SECONDS.
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ACCOUNT_LOCK_SECONDS=900
LOGIN_IP_MAX_FAILURES=100
LOGIN_IP_WINDOW_SECONDS=900

# Number of reverse proxies in front of the app. 0 (local development, no proxy) ignores X-Forwarded-For.
# Behind one proxy that appends the client address, set 1.
TRUST_PROXY=0

# Migrations and pnpm operator:create: connects as watheeq_owner. Never used by the running app.
MIGRATION_DATABASE_URL=postgres://watheeq_owner:watheeq_owner@localhost:5432/watheeq
