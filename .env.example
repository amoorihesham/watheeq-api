# Copy to .env for local development (never commit .env).
# Every key the app reads is listed here: required ones are set, optional overrides are commented with their default.
# Loaded by `pnpm dev`, `pnpm db:migrate`, and `pnpm operator:create`. `pnpm start` reads the real process environment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Background jobs this process runs: all, none, or comma-separated names (for example files.sweep,auth.token_cleanup).
JOBS=all

# Matches docker-compose.yml. Used by the app, migrations, and the operator CLI.
DATABASE_URL=postgres://watheeq:watheeq@localhost:5432/watheeq
# Password for `pnpm operator:create`; when unset the command prompts for it. Read by that command only.
# OPERATOR_PASSWORD=

# Access-token signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=local-development-only-jwt-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# Verification emails. Locally these go to Mailpit from docker-compose.yml: open http://localhost:8025 to read them.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional SMTP login, for providers that need one.
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM=Watheeq <no-reply@watheeq.local>
# The web app's origin; verification links point to ${APP_BASE_URL}/verify-email?token=...
APP_BASE_URL=http://localhost:5173
VERIFICATION_TOKEN_TTL_SECONDS=259200
# Password reset links; ${APP_BASE_URL}/reset-password?token=...
PASSWORD_RESET_TTL_SECONDS=3600

# Uploaded files. Locally these go to the SeaweedFS S3 server from docker-compose.yml (bucket created by `docker compose up`).
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=watheeq-files
STORAGE_ACCESS_KEY=watheeq
STORAGE_SECRET_KEY=watheeq-local-secret
STORAGE_FORCE_PATH_STYLE=true

# Operational overrides. Each line shows the default; remove the leading "# " and change the value to override it.
# A job's budget is the time after which a run stops starting new work; it must stay below its interval, so lowering an
# interval may require lowering its budget too. An unknown JOB_* name is ignored with a warning at startup.
# Milliseconds a shutdown waits for in-flight requests before closing their connections (1000 to 300000).
# SHUTDOWN_TIMEOUT_MS=10000
# Database connection timeout and the /health check's deadline (100 to 60000).
# DATABASE_TIMEOUT_MS=2000
# Parts of one upload sent to the store at the same time (1 to 10).
# STORAGE_UPLOAD_QUEUE_SIZE=2
# Escalation check (intervals 1000 to 604800000).
# JOB_REQUESTS_ESCALATIONS_INTERVAL_MS=60000
# JOB_REQUESTS_ESCALATIONS_BUDGET_MS=50000
# Subscription notices.
# JOB_SUBSCRIPTIONS_NOTICES_INTERVAL_MS=3600000
# File sweep (batch size 1 to 10000).
# JOB_FILES_SWEEP_INTERVAL_MS=900000
# JOB_FILES_SWEEP_BATCH_SIZE=100
# JOB_FILES_SWEEP_BUDGET_MS=120000
# Expired token cleanup.
# JOB_AUTH_TOKEN_CLEANUP_INTERVAL_MS=86400000
# JOB_AUTH_TOKEN_CLEANUP_BATCH_SIZE=1000
# Old read notifications cleanup.
# JOB_NOTIFICATIONS_CLEANUP_INTERVAL_MS=86400000
# JOB_NOTIFICATIONS_CLEANUP_BATCH_SIZE=1000
